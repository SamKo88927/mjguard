{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.SamKo88927/mjguard",
  "title": "mjguard",
  "description": "Drive any MuJoCo-modelled robot arm; every motion is checked in the model before it runs.",
  "repository": {
    "url": "https://github.com/SamKo88927/mjguard",
    "source": "github"
  },
  "version": "0.4.0",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "mjguard",
      "version": "0.4.0",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "serve",
          "description": "Run the MCP server"
        },
        {
          "type": "positional",
          "valueHint": "robot",
          "description": "Robot config TOML, or a built-in preset: ur5e, panda",
          "isRequired": true,
          "default": "ur5e"
        }
      ]
    }
  ]
}
